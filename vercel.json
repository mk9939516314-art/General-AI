{
  "version": 2,
  "name": "general-ai-platform",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/auth.js" },
    { "src": "/api/projects/(.*)", "dest": "/api/projects.js" },
    { "src": "/api/projects", "dest": "/api/projects.js" },
    { "src": "/api/wallet/(.*)", "dest": "/api/wallet.js" },
    { "src": "/api/wallet", "dest": "/api/wallet.js" },
    { "src": "/api/enterprise", "dest": "/api/enterprise.js" },
    { "src": "/api/eval/(.*)", "dest": "/api/eval.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}